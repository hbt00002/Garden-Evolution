{
  "name": "garden-evolution-phaser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply garden-evolution-leaderboard --local",
    "d1:migrate:remote": "wrangler d1 migrations apply garden-evolution-leaderboard --remote"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "vite": "^7.1.3",
    "wrangler": "^4.33.1"
  }
}
