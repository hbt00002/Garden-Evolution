{
  "name": "garden-evolution-phaser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply garden-evolution-leaderboard --local",
    "d1:migrate:remote": "wrangler d1 migrations apply garden-evolution-leaderboard --remote",
    "errors:remote": "wrangler d1 execute garden-evolution-leaderboard --remote --command \"SELECT count, kind, message, source, line, browser, device, build, last_seen FROM client_errors WHERE last_seen >= strftime('%Y-%m-%dT%H:%M:%fZ','now','-7 days') ORDER BY count DESC LIMIT 30\"",
    "e2e": "playwright test",
    "e2e:serve": "node e2e/serve.mjs"
  },
  "dependencies": {
    "@fontsource/oxanium": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "vite": "^7.1.3",
    "wrangler": "^4.33.1"
  }
}
